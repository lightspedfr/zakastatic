{
    on_demand_tls {
        ask http://localhost/internal-check
    }
}

# 1. Global HTTPS Block (Handles all valid production domains)
:443 {
    # Match long hosts (61+ chars) using native header regex matching
    @tooLong header_regexp Host ^.{61,}$

    # Match suspicious phishing strings inside the domain name
    @hasSus {
        header Host *whm*
        header Host *cpanel*
        header Host *login*
    }

    # Block long subdomains instantly
    handle @tooLong {
        header Content-Type "text/plain"
        respond "this link was disabled bc you generated a malware, sus, or just down right bad subdomain, stop abusing my BYOD system, this is to generate good links, NOT WHM EXPLOITS" 493
    }

    # Block suspicious keywords instantly
    handle @hasSus {
        header Content-Type "text/plain"
        respond "this link was disabled bc you generated a malware, sus, or just down right bad subdomain, stop abusing my BYOD system, this is to generate good links, NOT WHM EXPLOITS" 493
    }

    # Match /api and anything after it, then proxy to localhost:3000/wisp/
    handle /api* {
        uri strip_prefix /api
        rewrite * /wisp{uri}

        reverse_proxy localhost:3000 {
            header_up Host {upstream_host_port}

            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    # Match /wisp and /wisp/* to properly capture all client handshakes
    handle /wisp* {
        reverse_proxy localhost:3000 {
            header_up Host {upstream_host_port}

            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    # Static file fallback
    # If the requested file does not exist, serve /404.html
    handle {
        root * /usr/share/caddy

        @notFound {
            not file
        }

        rewrite @notFound /404.html

        file_server
    }

    tls {
        on_demand
    }
}

# 2. HTTP Block with Conditional 301 Redirect
:80 {
    # Match requests that are NOT localhost or 127.0.0.1
    @notLocalhost {
        not header Host localhost*
        not header Host 127.0.0.1*
    }

    # Redirect non-local traffic to HTTPS
    redir @notLocalhost https://{host}{uri} permanent

    # Local traffic fallback
    # Avoids redirect loops for local checks
    handle {
        root * /usr/share/caddy

        @notFound {
            not file
        }

        rewrite @notFound /404.html

        file_server
    }
}

# 3. Internal Check Block
http://localhost {
    respond /internal-check 200
}
