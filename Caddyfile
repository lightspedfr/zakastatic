{
    on_demand_tls {
        ask http://localhost/internal-check
    }
}

# 1. HTTPS
:443 {
    # Match long hosts (61+ characters)
    @tooLong header_regexp Host ^.{61,}$

    # Match suspicious phishing strings
    @hasSus {
        header Host *whm*
        header Host *cpanel*
        header Host *login*
    }

    # Block long subdomains
    handle @tooLong {
        header Content-Type "text/plain"
        respond "this link was disabled bc you generated a malware, sus, or just down right bad subdomain, stop abusing my BYOD system, this is to generate good links, NOT WHM EXPLOITS" 493
    }

    # Block suspicious keywords
    handle @hasSus {
        header Content-Type "text/plain"
        respond "this link was disabled bc you generated a malware, sus, or just down right bad subdomain, stop abusing my BYOD system, this is to generate good links, NOT WHM EXPLOITS" 493
    }

    # /api -> localhost:3000/wisp/
    handle /api* {
        uri strip_prefix /api
        rewrite * /wisp{uri}

        reverse_proxy localhost:3000 {
            header_up Host {upstream_host_port}

            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    # /wisp -> localhost:3000
    handle /wisp* {
        reverse_proxy localhost:3000 {
            header_up Host {upstream_host_port}

            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    # zaka.is-a.bot: / -> /bot.html
    @botRoot {
        host zaka.is-a.bot
        path /
    }

    handle @botRoot {
        rewrite * /bot.html
        root * /usr/share/caddy
        file_server
    }

    # All other domains: / -> /index.html
    @root {
        path /
    }

    handle @root {
        rewrite * /index.html
        root * /usr/share/caddy
        file_server
    }

    # Normal static files
    handle {
        root * /usr/share/caddy
        file_server
    }

    # Custom 404 page while preserving the 404 status
    handle_errors {
        @custom404 expression `{http.error.status_code} == 404`

        rewrite @custom404 /404.html

        root * /usr/share/caddy
        file_server
    }

    tls {
        on_demand
    }
}

# 2. HTTP
:80 {
    # CloudFront is explicitly allowed to remain on HTTP
    @cloudfront {
        host d1vajlb5xnngpm.cloudfront.net
    }

    # Serve CloudFront HTTP requests without redirecting them
    handle @cloudfront {
        root * /usr/share/caddy

        @cloudfrontRoot {
            path /
        }

        handle @cloudfrontRoot {
            rewrite * /index.html
            file_server
        }

        handle {
            file_server
        }
    }

    # Everything else that isn't localhost gets redirected to HTTPS
    @notLocalhost {
        not header Host localhost*
        not header Host 127.0.0.1*
    }

    redir @notLocalhost https://{host}{uri} permanent

    # Local HTTP traffic
    handle {
        root * /usr/share/caddy
        file_server
    }

    # Custom 404 page while preserving the 404 status
    handle_errors {
        @custom404 expression `{http.error.status_code} == 404`

        rewrite @custom404 /404.html

        root * /usr/share/caddy
        file_server
    }
}

# 3. Internal Check
http://localhost {
    respond /internal-check 200
}
