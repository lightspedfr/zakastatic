                transport http {
                    read_timeout 0
                    write_timeout 0
                }
            }
        }

        root * /usr/share/caddy

        @cloudfrontRoot path /

        handle @cloudfrontRoot {
            rewrite * /index.html
            file_server
        }

        handle {
            file_server
        }

        handle_errors {
