{
    on_demand_tls {
        ask http://localhost/internal-check
    }
}

# ============================================================
# CloudFront HTTP-only host
# ============================================================
http://d1vajlb5xnngpm.cloudfront.net {
    root * /usr/share/caddy

    # / -> /index.html
    @root path /

    handle @root {
        rewrite * /index.html
        file_server
    }

    # All other static paths
    handle {
        file_server
    }

    # Custom 404 page with actual 404 status
    handle_errors {
        @notFound expression `{http.error.status_code} == 404`

        rewrite @notFound /404.html
        file_server
    }
}


# ============================================================
# HTTPS
# ============================================================
:443 {
    # Match long hosts (61+ characters)
    @tooLong header_regexp Host ^.{61,}$

    # Match suspicious phishing strings
    @hasSus {
        header Host *whm*
        header Host *cpanel*
        header Host *login*
    }

    # Block long subdomains
    handle @tooLong {
        header Content-Type "text/plain"
        respond "this link was disabled bc you generated a malware, sus, or just down right bad subdomain, stop abusing my BYOD system, this is to generate good links, NOT WHM EXPLOITS" 493
    }

    # Block suspicious keywords
    handle @hasSus {
        header Content-Type "text/plain"
        respond "this link was disabled bc you generated a malware, sus, or just down right bad subdomain, stop abusing my BYOD system, this is to generate good links, NOT WHM EXPLOITS" 493
    }

    # --------------------------------------------------------
    # /api -> localhost:3000/wisp/
    # --------------------------------------------------------
    handle /api* {
        uri strip_prefix /api
        rewrite * /wisp{uri}

        reverse_proxy localhost:3000 {
            header_up Host {upstream_host_port}

            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    # --------------------------------------------------------
    # /wisp -> localhost:3000
    # --------------------------------------------------------
    handle /wisp* {
        reverse_proxy localhost:3000 {
            header_up Host {upstream_host_port}

            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    # --------------------------------------------------------
    # zaka.is-a.bot -> /bot.html
    # --------------------------------------------------------
    @botRoot {
        host zaka.is-a.bot
        path /
    }

    handle @botRoot {
        rewrite * /bot.html
        root * /usr/share/caddy
        file_server
    }

    # --------------------------------------------------------
    # All other domains -> /index.html
    # --------------------------------------------------------
    @root {
        path /
    }

    handle @root {
        rewrite * /index.html
        root * /usr/share/caddy
        file_server
    }

    # --------------------------------------------------------
    # Normal static files
    # --------------------------------------------------------
    handle {
        root * /usr/share/caddy
        file_server
    }

    # --------------------------------------------------------
    # Custom 404
    # --------------------------------------------------------
    handle_errors {
        @notFound expression `{http.error.status_code} == 404`

        rewrite @notFound /404.html

        root * /usr/share/caddy
        file_server
    }

    tls {
        on_demand
    }
}


# ============================================================
# Normal HTTP
# ============================================================
:80 {
    # Localhost is allowed to stay HTTP
    @localhost {
        header Host localhost*
    }

    handle @localhost {
        root * /usr/share/caddy
        file_server
    }

    @localhostIP {
        header Host 127.0.0.1*
    }

    handle @localhostIP {
        root * /usr/share/caddy
        file_server
    }

    # Everything else gets redirected to HTTPS
    redir https://{host}{uri} permanent
}


# ============================================================
# Internal Check
# ============================================================
http://localhost {
    respond /internal-check 200
}
