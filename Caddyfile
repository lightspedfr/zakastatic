{
    on_demand_tls {
        ask http://localhost/internal-check
    }
}

http://d1vajlb5xnngpm.cloudfront.net {
    handle /api* {
        uri strip_prefix /api
        rewrite * /wisp{uri}

        reverse_proxy localhost:3000 {
            header_up Host {upstream_host_port}

            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    handle /wisp* {
        reverse_proxy localhost:3000 {
            header_up Host {upstream_host_port}

            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    root * /usr/share/caddy

    @root path /

    handle @root {
        rewrite * /index.html
        file_server
    }

    handle {
        file_server
    }

    handle_errors {
        rewrite * /404.html
        file_server
    }
}

:443 {
    @tooLong header_regexp Host ^.{61,}$

    @hasSus {
        header Host *whm*
        header Host *cpanel*
        header Host *login*
    }

    handle @tooLong {
        header Content-Type "text/plain"
        respond "this link was disabled bc you generated a malware, sus, or just down right bad subdomain, stop abusing my BYOD system, this is to generate good links, NOT WHM EXPLOITS" 493
    }

    handle @hasSus {
        header Content-Type "text/plain"
