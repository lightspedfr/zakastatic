{
    on_demand_tls {
        ask http://localhost/internal-check
    }
}

http://d1vajlb5xnngpm.cloudfront.net {
    handle /api* {
        uri strip_prefix /api
        rewrite * /wisp{uri}
        reverse_proxy localhost:3000 {
            header_up Host {upstream_hostport}
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    handle /wisp* {
        reverse_proxy localhost:3000 {
            header_up Host {upstream_hostport}
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    handle / {
        rewrite * /index.html
        file_server
    }

    handle {
        root * /usr/share/caddy
        file_server
    }

    handle_errors {
        @404 expression `{http.error.status_code} == 404`
        rewrite @404 /404.html
        root * /usr/share/caddy
        file_server
    }
}

:443 {
    @tooLong header_regexp Host ^.{61,}$
    @hasSus header Host *whm* *cpanel* *login*

    respond @tooLong "Request denied" 493
    respond @hasSus "Request denied" 493

    handle /api* {
        uri strip_prefix /api
        rewrite * /wisp{uri}
        reverse_proxy localhost:3000 {
            header_up Host {upstream_hostport}
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    handle /wisp* {
        reverse_proxy localhost:3000 {
            header_up Host {upstream_hostport}
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    @botHost host zaka.is-a.bot
    handle @botHost {
        @root path /
        rewrite @root /bot.html
        root * /usr/share/caddy
        file_server
    }

    @normalRoot path /
    handle @normalRoot {
        rewrite * /index.html
        root * /usr/share/caddy
        file_server
    }

    handle {
        root * /usr/share/caddy
        file_server
    }

    handle_errors {
        @404 expression `{http.error.status_code} == 404`
        rewrite @404 /404.html
        root * /usr/share/caddy
        file_server
    }

    tls {
        on_demand
    }
}

