:80 {
    @localhost {
        header Host localhost*
    }

    handle @localhost {
        root * /usr/share/caddy
        file_server
    }

    @localhostIP {
        header Host 127.0.0.1*
    }

    handle @localhostIP {
        root * /usr/share/caddy
        file_server
    }

    @cloudfront {
        header Host d1vajlb5xnngpm.cloudfront.net
    }

    handle @cloudfront {
        handle /api* {
            uri strip_prefix /api
            rewrite * /wisp{uri}

            reverse_proxy localhost:3000 {
                header_up Host {upstream_host_port}

                transport http {
                    read_timeout 0
                    write_timeout 0
