:80 {
    @cloudfront header Host d1vajlb5xnngpm.cloudfront.net
    handle @cloudfront {
        handle /api* {
            uri strip_prefix /api
            rewrite * /wisp{uri}
            reverse_proxy localhost:3000 {
                header_up Host {upstream_hostport}
                transport http {
                    read_timeout 0
                    write_timeout 0
                }
            }
        }

        handle /wisp* {
            reverse_proxy localhost:3000 {
                header_up Host {upstream_hostport}
                transport http {
                    read_timeout 0
                    write_timeout 0
                }
            }
        }

        handle / {
            rewrite * /index.html
            root * /usr/share/caddy
            file_server
        }

        handle {
            root * /usr/share/caddy
            file_server
        }
    }

    @localhost header Host localhost*
    handle @localhost {
        root * /usr/share/caddy
        file_server
    }

    @private10 header Host 10.*
    @private192 header Host 192.168.*
    @private172 header_regexp Host ^172\.(1[6-9]|2[0-9]|3[0-1])\.

    handle @private10 {
        root * /usr/share/caddy
        file_server
    }

    handle @private192 {
        root * /usr/share/caddy
        file_server
    }

    handle @private172 {
        root * /usr/share/caddy
        file_server
    }

    redir https://{host}{uri} permanent
}

